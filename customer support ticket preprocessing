# Import Libraries
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# Load Dataset
data = pd.read_csv("customer_support_tickets.csv")
df = pd.DataFrame(data)

# Basic Data Inspection
print(df.head())
print(df.shape)
print(df.info())
print(df.isnull().sum())
print(df.duplicated().sum())

# Standardize Column Names
df.columns = (df.columns.str.lower().str.strip().str.replace(' ', '_'))

# Convert Date Columns
df['date_of_purchase'] = pd.to_datetime(df['date_of_purchase'])
df['first_response_time'] = pd.to_datetime(df['first_response_time'])
df['time_to_resolution'] = pd.to_datetime(df['time_to_resolution'])

# Standardize Categorical Values
cat = df.select_dtypes(include='object')

for c in cat:
  df[c] = df[c].str.lower().str.strip()

# Explore Categorical Columns
for c in ['customer_gender','product_purchased','ticket_type','ticket_subject','ticket_status','ticket_priority','ticket_channel']:
  print(f"\n------------- {c} -------------")
  print(df[c].value_counts())

