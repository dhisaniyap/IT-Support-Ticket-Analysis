# Create Product Category Column
df['product_category'] = df['product_purchased'].map(category_map)

# Standardize Ticket Status
df['ticket_status'] = df['ticket_status'].replace(
'pending customer response',
'pending'
)

# Check Unmapped Products
print(df[df['product_category'].isnull()]['product_purchased'].unique())

# Analyze Missing Values for Closed Tickets
for i in ['resolution','first_response_time','time_to_resolution','customer_satisfaction_rating']:
  print(f"Total null in {i}:",(df[df['ticket_status'] == 'closed'])[i].isnull().sum())

# Fill Missing Resolution Values
df['resolution'] = df['resolution'].fillna('not resolved yet')

# Analyze Missing Values for Pending Tickets
for i in ['first_response_time','time_to_resolution','customer_satisfaction_rating']:
  print(f"Total null in {i}:",(df[df['ticket_status'] == 'pending'])[i].isnull().sum())

# Analyze Missing Values for Open Tickets
for i in ['first_response_time','time_to_resolution','customer_satisfaction_rating']:
  print(f"Total null in {i}:",(df[df['ticket_status'] == 'open'])[i].isnull().sum())

# Create Resolution Delay Column
df.loc[df['ticket_status'] == 'closed','resolution_delay_hours'] = ((df['time_to_resolution']- df['first_response_time']).dt.total_seconds() / 3600)

# Remove Negative Resolution Delays
df.loc[df['resolution_delay_hours'] < 0,'resolution_delay_hours'] = np.nan

# Round Resolution Delay
df['resolution_delay_hours'] = (df['resolution_delay_hours'].round(1))

# Create Time-Based Features
df['response_hour'] = df['first_response_time'].dt.hour
df['response_day'] = df['first_response_time'].dt.day_name()

# Exploratory Data Analysis

# Resolution Delay by Ticket Priority
sns.barplot(
x='ticket_priority',
y='resolution_delay_hours',
data=df
)
plt.show()

# Customer Satisfaction by Gender
sns.barplot(
x='customer_gender',
y='customer_satisfaction_rating',
data=df
)
plt.show()

# Ticket Count by Product Category
sns.countplot(
x='product_category',
data=df
)
plt.xticks(rotation=45)
plt.show()

